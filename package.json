{
    "name": "gregmat-server",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "start": "pm2 start ecosystem.config.js --env production",
        "stop": "pm2 stop gregmat-server",
        "restart": "pm2 restart gregmat-server",
        "delete": "pm2 delete gregmat-server",
        "logs": "pm2 logs gregmat-server --json",
        "dev": "nodemon -r tsconfig-paths/register src/app.ts",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "format": "prettier --write .",
        "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json && npm run copy-templates",
        "copy-templates": "copyfiles -u 0 \"src/shared/services/emails/templates/**/*.ejs\" build/",
        "seeds:dev": "ts-node -r tsconfig-paths/register src/seeds/index.ts",
        "seeds:prod": "node ./build/src/seeds/index.js",
        "precommit": "npm run lint && npm run format"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@eslint/js": "^9.33.0",
