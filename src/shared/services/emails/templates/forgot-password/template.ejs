<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Reset your password</title>

        <style>
            /* Safe dark mode tuning (text + container only) */
            @media (prefers-color-scheme: dark) {
                body {
                    background-color: #0f172a !important;
                }

                .container {
                    background-color: #020617 !important;
                }

                .text {
                    color: #e5e7eb !important;
                }

                .muted {
                    color: #9ca3af !important;
                }

                .button {
                    background-color: #38bdf8 !important;
                    color: #020617 !important;
                }
            }
        </style>
    </head>

    <body
        style="
            margin: 0;
            padding: 0;
            background-color: #f4f6f8;
            font-family: 'Open Sans', Arial, sans-serif;
        "
    >
        <!-- Preheader -->
        <div
            style="
                display: none;
                max-height: 0;
                overflow: hidden;
                font-size: 1px;
                line-height: 1px;
                color: #ffffff;
                opacity: 0;
            "
        >
            Reset your password to regain access to your GregMat account.
        </div>

        <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            bgcolor="#f4f6f8"
            style="padding: 24px 0"
        >
            <tr>
                <td align="center">
                    <!-- Main Container -->
                    <table
                        width="600"
                        cellpadding="0"
                        cellspacing="0"
                        class="container"
                        style="
                            max-width: 600px;
                            background-color: #ffffff;
                            border-radius: 12px;
                            overflow: hidden;
                        "
                    >
                        <!-- Logo -->
                        <tr>
                            <td align="center" style="padding: 32px 0">
                                <img
                                    src="<%= logo_url %>"
                                    width="140"
                                    alt="GregMat"
                                    style="display: block; border: 0; max-width: 100%"
                                />
                            </td>
                        </tr>

                        <!-- Content -->
                        <tr>
                            <td
                                class="text"
                                style="
                                    padding: 0 32px 24px;
                                    color: #1f2937;
                                    font-size: 16px;
                                    line-height: 24px;
                                "
                            >
                                <p style="margin: 0 0 16px">Hi <strong><%= username %></strong>,</p>

                                <p style="margin: 0 0 16px">
                                    We received a request to reset the password for your
                                    <strong>GregMat</strong> account. Click the button below to set
                                    a new password.
                                </p>

                                <p style="margin: 0 0 16px">
                                    If you didn’t request this, you can safely ignore this email.
                                    Your account will remain secure.
                                </p>
                            </td>
                        </tr>

                        <!-- CTA -->
                        <tr>
                            <td align="center" style="padding-bottom: 32px">
                                <a
                                    href="<%= resetLink %>"
                                    target="_blank"
                                    class="button"
                                    style="
                                        background-color: #50b5ff;
                                        color: #ffffff;
                                        text-decoration: none;
                                        font-size: 16px;
                                        font-weight: 600;
                                        padding: 14px 28px;
                                        border-radius: 6px;
                                        display: inline-block;
                                    "
                                >
                                    Reset Password
                                </a>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td
                                class="muted"
                                style="
                                    padding: 0 32px 40px;
                                    color: #6b7280;
                                    font-size: 14px;
                                    line-height: 22px;
                                    text-align: center;
                                "
                            >
                                <p style="margin: 0 0 12px">
                                    This link will expire in <strong>1 hour</strong> for your
                                    security.
                                </p>

                                <p style="margin: 0">
                                    If you continue to have trouble signing in, please contact our
                                    support team.
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
